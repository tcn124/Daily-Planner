{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Save and open a planner backup the user picks in a native dialog.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
